# Copy to .env and adjust.
DATABASE_URL="postgresql://lifeos:lifeos@localhost:5432/lifeos"
APP_URL="http://localhost:3000"

# open            = anyone can register
# first-user-only = registration works only until the first account exists (recommended for a personal install)
# closed          = registration disabled
REGISTRATION_MODE="first-user-only"

# Password-reset email. "console" prints the reset link in the server log (development).
EMAIL_PROVIDER="console"
EMAIL_FROM="LifeOS <no-reply@example.com>"
RESEND_API_KEY=""

# Same value as DATABASE_URL_UNPOOLED (Neon gives you both). Needed only so `prisma migrate deploy`
# can take its advisory lock — PgBouncer's pooled connection can't hold one.
DIRECT_URL=""
